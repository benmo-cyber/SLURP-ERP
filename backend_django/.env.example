# Copy to `.env` in this folder (`.env` is gitignored).
# Mapbox: https://account.mapbox.com/access-tokens/ — token needs Geocoding.

MAPBOX_ACCESS_TOKEN=

# Microsoft 365 SMTP (PO / invoice / SO emails)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=customerservice@wildwoodingredients.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=customerservice@wildwoodingredients.com
EMAIL_REPLY_TO=customerservice@wildwoodingredients.com
